{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CTO Brain pack manifest",
  "type": "object",
  "required": ["version", "package", "tier", "skills"],
  "properties": {
    "version": { "type": "string" },
    "package": { "type": "string" },
    "tier": { "enum": ["public", "signed", "encrypted"] },
    "created": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256", "tier"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "tier": { "type": "string" },
          "export": { "enum": ["allowed", "never"] }
        }
      }
    }
  }
}
